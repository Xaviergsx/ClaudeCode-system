{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Grep",
      "Glob",
      "Edit(./wiki/**)",
      "Write(./wiki/**)",
      "Edit(./index.md)",
      "Write(./index.md)",
      "Edit(./log.md)",
      "Write(./log.md)",
      "Write(./raw/**)",
      "Edit(./raw/README.md)",
      "Bash(python3 scripts/brain_lint.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(date:*)"
    ],
    "deny": [
      "Edit(./CLAUDE.md)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./templates/**)",
      "Edit(./.obsidian/**)",
      "Write(./.obsidian/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ]
  }
}
